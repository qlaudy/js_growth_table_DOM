"use strict";
// write code here
var table = document.querySelector(".field");
var tbody = table;
var buttonAppendRow = document.querySelector(".append-row");
var buttonRemoveRow = document.querySelector(".remove-row");
var buttonAppendColumn = document.querySelector(".append-column");
var buttonRemoveColumn = document.querySelector(".remove-column");
function updateButtons() {
    var rowsCount = tbody.children.length;
    var columnsCount = tbody.firstElementChild.children.length;
    buttonAppendRow.disabled = rowsCount >= 10;
    buttonRemoveRow.disabled = rowsCount <= 2;
    buttonAppendColumn.disabled = columnsCount >= 10;
    buttonRemoveColumn.disabled = columnsCount <= 2;
}
buttonAppendRow.addEventListener("click", function(events) {
    var tr = document.createElement("tr");
    var children = tbody.firstElementChild;
    if (tbody.children.length >= 10) return;
    for(var i = 0; i < children.children.length; i++){
        var td = document.createElement("td");
        tr.append(td);
    }
    tbody.append(tr);
    updateButtons();
});
buttonRemoveRow.addEventListener("click", function(events) {
    var tbodyClean = tbody.lastElementChild;
    if (tbody.children.length > 2) tbody.removeChild(tbodyClean);
    updateButtons();
});
buttonAppendColumn.addEventListener("click", function(events) {
    if (tbody.firstElementChild.children.length >= 10) return;
    var fullTr = tbody.children;
    for(var i = 0; i < fullTr.length; i++){
        var newTd = document.createElement("td");
        fullTr[i].append(newTd);
    }
    updateButtons();
});
buttonRemoveColumn.addEventListener("click", function(events) {
    if (tbody.firstElementChild.children.length <= 2) return;
    var fullTr = tbody.children;
    for(var i = 0; i < fullTr.length; i++){
        var last = fullTr[i].lastElementChild;
        last.remove();
    }
    updateButtons();
});

